KMA_SERVICE_KEY=
KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0

SEOUL_RAINFALL_API_KEY=
SEOUL_RIVER_API_KEY=
HSR_API_AUTH_KEY=
HSR_AREA_COMP_TYPE=CPP
HSR_AREA_DATA_TYPE_CD=CZ

# 선택: 서울시 건설공사 추진 현황(ListOnePMISBizInfo) 수집기용
SEOUL_CONSTRUCTION_API_KEY=

# 선택: 서울 열린데이터광장 OA-15439 생활인구(내국인) 수집기용
# 실제 키는 .env에만 두고 저장소에 커밋하지 마세요.
SEOUL_OPEN_API_KEY=

# PostgreSQL — 팀원은 본인이 만든 DB·계정에 맞게 수정 (작성자 .env와 같을 필요 없음)
# 로컬에서 새로 만들었다면: createdb / createuser 한 이름·비밀번호를 그대로 적으면 됨
# 팀 공용 DB 서버를 쓰면: 그 호스트·DB명·계정으로 바꿈
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weather
DB_USER=postgres
DB_PASSWORD=postgres

